<h1><%= @task.title %></h1>

<p><%= @task.details %></p>

<p>
  <% if @task.completed %>
    This task is completed
  <% else %>
    This task is not completed yet
  <% end %>
</p>

<%# ➕ le lien vers le formulaire de modification de CETTE tâche %>
<%= link_to edit_task_path(@task), class: "btn btn-outline-secondary me-2" do %>
  <i class="fa-solid fa-pen"></i> Edit this task
<% end %>

<%= link_to "Back to my tasks", tasks_path %>
